# Generated by each member's build.mcpp — pango-features.h, config.h and
# pango-enum-types.{h,c}. An artifact produced at build time cannot disagree
# with the data it came from, which is the whole reason not to commit it.
mcpp/*/include/*
!mcpp/*/include/.gitkeep

# The module wrappers, likewise generated — 1,223 `using ::` lines across the
# three. `src/.gitkeep` is committed for the same reason `include/.gitkeep` is:
# mcpp reads the manifest before running the build program, and an entry naming
# a path that is not there is dropped WITHOUT AN ERROR.
mcpp/*/src/*.cppm
!mcpp/*/src/.gitkeep

# mcpp build output
mcpp/*/target/
.mcpp/
compile_commands.json
mcpp.lock

# upstream/ is never filtered. pango ships .gitignore files of its own, and a
# fork that commits its tree gets them applied — the cairo fork lost five
# release files that way before its "upstream is the tarball" check caught it.
!upstream/**
