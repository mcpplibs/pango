// gnome.pangocairo — the same generators, plus HAVE_CAIRO and
// HAVE_CAIRO_FREETYPE.
#include <algorithm>
#include <cctype>
#include <cstdio>
#include <cstring>
#include <filesystem>
#include <fstream>
#include <set>
#include <sstream>
#include <string>
#include <vector>

import mcpp;

#include "../common/prelude.h"
#include "../common/modules.h"

int main()
{
    if (std::string(mcpp::target_os()) != "linux") {
        note("this package builds pangocairo for Linux only.\n");
        return 1;
    }
    // HAVE_CAIRO_FREETYPE is what pangocairo-fontmap.c tests to decide whether
    // to register the fontconfig-backed font map. Without it pangocairo builds
    // and then finds no fonts at run time — a silent degradation, so the macro
    // is set by the member that actually compiles the fc sources.
    pango_common_setup({"HAVE_CAIRO", "HAVE_CAIRO_FREETYPE", "HAVE_FREETYPE"});

    // ✅ cairo.h IS NO LONGER SCANNED HERE, and the sequencing mattered as
    // much as the fix.
    //
    // freedesktop.cairo 1.18.2-mcpp2 exported 470 names and was missing
    // `cairo_t` and all 192 enumerators, so re-exporting it did not give this
    // member's own signatures the types they take. The gap was found FROM
    // HERE: pangocairo cannot mix the header and module routes (pangocairo.h
    // reaches glib and therefore <stdio.h>), so it had to ask the module.
    //
    // ⚠️ THE WORKAROUND COULD NOT BE REMOVED IN THE SAME CHANGE THAT FIXED
    // CAIRO. This package resolves cairo from the PUBLISHED index, and an
    // index PR cannot test both at once — a member may declare only ONE
    // project-level index repo:
    //
    //     error: ≥2 project-level index repos is a known xlings resolution gap
    //
    // so `tests/examples/pangocairo` cannot use a local `gnome.*` descriptor
    // and a local `freedesktop.*` descriptor together. cairo landed first
    // (mcpp3, 697 names); this follows.
    gen_module("gnome.pangocairo", {"pango/pangocairo.h"},
               {g_up / "pango" / "pangocairo.h"},
               g_root / "src" / "pangocairo.cppm",
               g_inc / "pango" / "pangocairo-macros.h",
               "pango/pangocairo-macros.h",
               /*min_exports=*/25,   // upstream ships 33 pango_cairo_* functions
               // pangocairo.h includes <cairo.h>, so the module must carry
               // cairo's names too — `cairo_t` and `cairo_surface_t` are in
               // this member's own signatures. freedesktop.cairo exposes a
               // module of its own, which is what makes this possible.
               /*reexports=*/{"gnome.pango", "gnome.pangoft2", "cairo"});

    mcpp::rerun_if_changed("build.mcpp");
    return 0;
}
